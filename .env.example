# zen2api 环境变量示例
# 用法：复制为 .env（或直接 export / 写进 systemd 的 EnvironmentFile）

# ── 网关 server.js ──────────────────────────────────────────────
# 监听地址（默认 127.0.0.1:18500；对外只建议绑内网/tailnet 地址）
HOST=127.0.0.1
PORT=18500

# 上游（一般不用改）
ZEN_UPSTREAM=https://opencode.ai/inference/openai/v1

# 出口代理（可选，但强烈建议）
# 免费池的 429 吃出口 IP 的数量与新鲜度；挂一个代理池能显著压下去。
# 支持任意 HTTP 代理（resin / clash / warp / squid…），Bun 原生生效：
# HTTPS_PROXY=http://<pool-user>:<pool-token>@127.0.0.1:2260
# HTTP_PROXY=http://<pool-user>:<pool-token>@127.0.0.1:2260
# NO_PROXY=127.0.0.1,localhost

# 客户端鉴权（可选；不设 = 任何 key 都收，方便内网/单人使用）
# ZEN_CLIENT_KEY=your-key

# 请求日志（可选；每行一条 JSON，面板的「实时请求日志」读它）
ZEN_LOG=./requests.jsonl

# 请求形状覆盖（一般不用动）
# ZEN_UA=opencode/latest/2.0.29/cli
# ZEN_TIMEOUT_MS=600000
# ZEN_STRIP_REASONING=1
# ZEN_ALIASES={"claude-sonnet-5":"muse-spark-1.3-contributor-free"}
# ZEN_MODELS_URL=https://opencode.ai/zen/v1/models

# ── 面板 panel/server.js ────────────────────────────────────────
# PANEL_HOST=127.0.0.1
# PANEL_PORT=18505
# PANEL_GW=http://127.0.0.1:18500
# PANEL_PUBLIC_URL=http://your-host:18500     # 生成接入示例用；默认占位符
# PANEL_REQ_LOG=./requests.jsonl              # 不设则不显示请求流卡片
# PANEL_CPA_CONFIG=/path/to/config.yaml       # 不设则不显示 CPA 白名单列
# PANEL_LAST_SYNC=/path/to/last-sync.json     # 不设则不显示同步卡片
# PANEL_SVC_ENV=/path/to/service.env          # 不设则不显示出网方式行

# 出口池卡片（resin 类管理 API；四项全设才显示）
# PANEL_RESIN_ENV=/opt/resin/.env
# PANEL_RESIN_API=http://127.0.0.1:2260/api/v1
# PANEL_RESIN_PLATFORM_ID=00000000-0000-0000-0000-000000000000
# PANEL_RESIN_SUB_ID=00000000-0000-0000-0000-000000000000
